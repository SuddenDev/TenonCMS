TENON_SECRET=change-me-to-at-least-32-random-chars-please

# A SQLite file, relative to the working directory. It's recommended to use an absolute path or Turso (libsql://<db>-<org>.turso.io) in production.
# DATABASE_URL=file:./cms.db
# Optional Turso auth token. If you use a local file, you won't need it.
# DATABASE_AUTH_TOKEN=

# The Next.js site. CORS allows its origin, and the admin opens permalinks on it.
TENON_SITE_URL=http://localhost:3000
# This CMS. Sign-in uses it, and media URLs are absolute on it.
TENON_CMS_URL=http://localhost:3200
