---
import { edit } from "integral-cms/preview";

const post = await Astro.locals.integral.findOne("posts", { where: { slug: Astro.params.slug! } });
if (!post) return new Response("Not found", { status: 404 });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post.title}</title>
  </head>
  <body>
    <a href="/">All posts</a>
    <h1 data-cms={edit("posts", post.id, "title")}>{post.title}</h1>
    {post.author && <p data-cms={edit("posts", post.id, "author")}>By {post.author.name}</p>}
    {post.hero && (
      <img
        data-cms={edit("posts", post.id, "hero")}
        data-cms-attr="src,srcset,alt"
        src={post.hero.src}
        srcset={post.hero.srcset}
        alt={post.hero.alt ?? ""}
      />
    )}
    <p data-cms={edit("posts", post.id, "body")}>{post.body}</p>
  </body>
</html>
