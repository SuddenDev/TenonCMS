---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script>
      import { TENON_CMS_URL } from "astro:env/client";
      import { preview } from "tenoncms/preview";

      // The admin bar for signed-in editors, and live preview in the admin's visual editor.
      // `morph` renders the page again from the server after each draft save.
      preview({ admin: `${TENON_CMS_URL}/admin`, morph: true });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
