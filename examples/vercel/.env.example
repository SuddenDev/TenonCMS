CMS_SECRET=change-me-to-at-least-32-random-chars-please
# Neon from the Vercel Marketplace: the pooled connection string.
DATABASE_URL=postgres://user:password@localhost:5432/cms
# AWS S3 from the Vercel Marketplace sets these. `vercel env pull` adds VERCEL_OIDC_TOKEN for local runs.
AWS_REGION=eu-central-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/vercel
S3_BUCKET_NAME=my-bucket
MEDIA_URL=https://my-bucket.s3.eu-central-1.amazonaws.com
