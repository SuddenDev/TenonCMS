---
import type { GetStaticPaths } from "astro";
import cms from "../../../tenon.config";
import Post from "../../components/Post.astro";
import { findPost } from "../../lib/find-post";

// Built at deploy time. The deploy button in the admin bar rebuilds it; the admin previews drafts on /preview.
export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await cms.find("posts", { select: { slug: true } });
  return posts.map((post) => ({ params: { slug: post.slug } }));
}) satisfies GetStaticPaths;

const post = (await findPost(Astro.locals.tenon, Astro.params.slug))!;
---

<Post post={post} />
