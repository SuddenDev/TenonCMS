TENON_SECRET=change-me-to-at-least-32-random-chars-please
# Defaults to ./cms.db, relative to the working directory. Use an absolute path or a libsql:// URL in production.
# DATABASE_URL=file:/var/lib/my-site/cms.db

# The origin of this CMS: API and admin. Set in production; development detects the origin automatically.
# TENON_CMS_URL=https://cms.example.com

# The origin of a site that renders the posts, like examples/headless-site. It gets CORS and the posts' permalinks.
# A site on another origin MUST also set TENON_CMS_URL.
# TENON_SITE_URL=https://www.example.com
