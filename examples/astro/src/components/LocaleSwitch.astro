---
import { switchTarget } from "tenoncms";
import cms from "../../tenon.config";

interface Props {
  alternates?: Record<string, string>;
}

const { alternates } = Astro.props;
const { locale, path } = Astro.locals;
const l = cms.localization!;
---

<nav aria-label="Language">
  {l.locales.map((code) =>
    code === locale ? (
      <strong>{code}</strong>
    ) : (
      <a href={switchTarget(l, path, code, alternates)} hreflang={code}>
        {code}
      </a>
    ),
  )}
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
