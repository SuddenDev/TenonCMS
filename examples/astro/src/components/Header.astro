---
import { localizePath } from "integral-cms";
import cms from "../../integral.config";
import LocaleSwitch from "./LocaleSwitch.astro";

interface Props {
  alternates?: Record<string, string>;
}

const { alternates } = Astro.props;
const { integral, locale } = Astro.locals;
const pages = (
  await integral.find("pages", { locale, select: { title: true, path: true } })
).filter((page) => page.path);
const l = cms.localization!;
---

<header>
  <nav aria-label="Main">
    <a href="/">
      <strong>Home</strong>
    </a>
    <a href="/#posts">Posts</a>
    {pages.map((page) => (
      <a href={localizePath(page.path!, locale as string, l)}>{page.title}</a>
    ))}
    <a href="/admin">Admin</a>
  </nav>
  {locale && <LocaleSwitch alternates={alternates} />}
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
