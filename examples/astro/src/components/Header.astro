---
import { localizePath, menuItems } from "tenoncms";
import cms from "../../tenon.config";
import LocaleSwitch from "./LocaleSwitch.astro";
import MenuList from "./MenuList.astro";

interface Props {
  alternates?: Record<string, string>;
}

const { alternates } = Astro.props;
const { tenon, locale } = Astro.locals;
// The main menu from the admin. Until it has items, the header lists the pages.
const menu = menuItems((await tenon.getGlobal("mainMenu", { locale })).items);
const pages = menu.length
  ? []
  : (await tenon.find("pages", { locale, select: { title: true, path: true } })).filter(
      (page) => page.path,
    );
const l = cms.localization!;
---

<header>
  <nav aria-label="Main">
    <a href="/">
      <strong>Home</strong>
    </a>
    <a href="/#posts">Posts</a>
    {menu.length > 0 && <MenuList items={menu} />}
    {pages.map((page) => (
      <a href={localizePath(page.path!, locale as string, l)}>{page.title}</a>
    ))}
    <a href="/admin">Admin</a>
  </nav>
  {locale && <LocaleSwitch alternates={alternates} />}
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-start;
  }
</style>
