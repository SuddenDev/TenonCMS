---
import { seoMeta, ValidationError } from "integral-cms";
import { edit } from "integral-cms/preview";
import Header from "../../../components/Header.astro";

export const prerender = false;

// `[...locale]` is empty for the default locale (`/posts/x`) and the locale code otherwise (`/de/posts/x`).
// `locals.path` drops a valid prefix only, so `/xx/posts/x` keeps it and is a 404.
const { integral: cms, locale, path } = Astro.locals;
const slug = Astro.params.slug!;
const post =
  path === `/posts/${slug}`
    ? await cms.findOne("posts", { where: { slug }, locale, alternates: true })
    : undefined;
if (!post) return new Response("Not found", { status: 404 });
const general = await cms.getGlobal("general", { locale });
const text = await cms.getGlobal("strings", { locale, fallback: false });
const meta = seoMeta(post, { general });

// The access rules of `comments` let anyone create one. It waits for approval, so the page redirects to a note.
let input = { name: "", body: "" };
let errors: Record<string, string> = {};
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  input = { name: String(form.get("name") ?? ""), body: String(form.get("body") ?? "") };
  try {
    await cms.create("comments", { post: post.id, ...input });
    return Astro.redirect(`${Astro.url.pathname}?commented#comments`, 303);
  } catch (e) {
    if (!(e instanceof ValidationError)) throw e;
    errors = e.errors;
  }
}
const comments = await cms.find("comments", { where: { post: post.id }, populate: false });
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{post.title}</title>
    {meta.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
  </head>
  <body>
    <Header alternates={post.alternates} />
    <h1 data-cms={edit("posts", post.id, "title")}>{post.title}</h1>
    {post.author && (
      <p style="color:blue" data-cms={edit("authors", post.author.id, "name")}>
        {post.author.name}
      </p>
    )}
    {post.publishedAt && <time datetime={post.publishedAt}>{post.publishedAt}</time>}
    {post.hero && (
      <img
        src={post.hero.src}
        srcset={post.hero.srcset}
        sizes="(min-width: 720px) 720px, 100vw"
        width={post.hero.width}
        height={post.hero.height}
        alt={post.hero.alt ?? ""}
        style="max-width: 100%; height: auto"
        data-cms={edit("posts", post.id, "hero")}
        data-cms-attr="src,srcset,alt"
      />
    )}
    <p style="white-space: pre-wrap" data-cms={edit("posts", post.id, "body")}>
      {post.body}
    </p>
    <section id="comments">
      <h2>{text.comments}</h2>
      {comments.map((comment) => (
        <article>
          <strong>{comment.name}</strong>
          <p style="white-space: pre-wrap">{comment.body}</p>
        </article>
      ))}
      {Astro.url.searchParams.has("commented") && <p role="status">{text.commentThanks}</p>}
      <form method="post" style="display: grid; gap: 0.5rem; max-width: 30rem">
        <label>
          {text.commentName}
          <input name="name" required maxlength="80" value={input.name} />
        </label>
        {errors.name && <p role="alert">{errors.name}</p>}
        <label>
          {text.commentBody}
          <textarea name="body" required maxlength="2000">{input.body}</textarea>
        </label>
        {errors.body && <p role="alert">{errors.body}</p>}
        <button>{text.commentSend}</button>
      </form>
    </section>
    <a href="/" data-cms={edit("strings", null, "allPosts")}>
      {text.allPosts}
    </a>
  </body>
</html>
