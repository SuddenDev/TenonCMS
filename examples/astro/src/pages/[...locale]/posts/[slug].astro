---
import { seoMeta } from "integral-cms";
import { edit } from "integral-cms/preview";
import LocaleSwitch from "../../../components/LocaleSwitch.astro";

export const prerender = false;

// `[...locale]` is empty for the default locale (`/posts/x`) and the locale code otherwise (`/de/posts/x`).
// `locals.path` drops a valid prefix only, so `/xx/posts/x` keeps it and is a 404.
const { integral: cms, locale, path } = Astro.locals;
const slug = Astro.params.slug!;
const post =
  path === `/posts/${slug}`
    ? await cms.findOne("posts", { where: { slug }, locale, alternates: true })
    : undefined;
if (!post) return new Response("Not found", { status: 404 });
const general = await cms.getGlobal("general", { locale });
const meta = seoMeta(post, { general });
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{post.title}</title>
    {meta.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
  </head>
  <body>
    <a href="/">← Home</a>
    {locale && <LocaleSwitch locale={locale} path={path} alternates={post.alternates} />}
    <h1 data-cms={edit("posts", post.id, "title")}>{post.title}</h1>
    {post.author && (
      <p style="color:blue" data-cms={edit("authors", post.author.id, "name")}>
        {post.author.name}
      </p>
    )}
    {post.publishedAt && <time datetime={post.publishedAt}>{post.publishedAt}</time>}
    {post.hero && (
      <img
        src={post.hero.src}
        srcset={post.hero.srcset}
        sizes="(min-width: 720px) 720px, 100vw"
        width={post.hero.width}
        height={post.hero.height}
        alt={post.hero.alt ?? ""}
        style="max-width: 100%; height: auto"
        data-cms={edit("posts", post.id, "hero")}
        data-cms-attr="src,srcset,alt"
      />
    )}
    <p style="white-space: pre-wrap" data-cms={edit("posts", post.id, "body")}>
      {post.body}
    </p>
  </body>
</html>
