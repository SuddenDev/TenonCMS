---
import { Seo } from "tenoncms/astro/components";
import { edit } from "tenoncms/preview";
import Blocks from "../components/Blocks.astro";
import Header from "../components/Header.astro";
import { findPage } from "../lib/find-page";

export const prerender = false;

// Static routes like `/` and `/about` win over this one, so CMS pages at those paths never show.
// `locals.path` is the URL path without the locale prefix.
const { tenon: cms, locale, path } = Astro.locals;
const page = await findPage(cms, path, locale);
if (!page) return new Response("Not found", { status: 404 });
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <Seo page={page} />
  </head>
  <body>
    <Header alternates={page.alternates} />
    <h1 data-cms={edit("pages", page.id, "title")}>{page.title}</h1>
    {page.content && <Blocks id={page.id} path="content" items={page.content} />}
  </body>
</html>
