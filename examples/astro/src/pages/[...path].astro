---
import { seoMeta } from "integral-cms";
import { edit } from "integral-cms/preview";

export const prerender = false;

// Static routes like `/` and `/about` win over this one, so CMS pages at those paths never show.
const path = `/${Astro.params.path ?? ""}`;
const { integral: cms } = Astro.locals;
const page = await cms.findOne("pages", {
  where: { path },
  populate: { hero: true, seo: { image: true } },
  select: {
    title: true,
    path: true,
    body: true,
    seo: true,
    hero: true,
  },
});
if (!page) return new Response("Not found", { status: 404 });
const [general, seo] = await Promise.all([cms.getGlobal("general"), cms.getGlobal("seo")]);
const meta = seoMeta(page, { general, seo });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    {meta.noindex && <meta name="robots" content="noindex" />}
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    {meta.image && <meta property="og:image" content={meta.image} />}
    {meta.verification.map((tag) => (
      <meta name={tag.name} content={tag.content} />
    ))}
  </head>
  <body>
    <a href="/">← Home</a>
    <h1 data-cms={edit("pages", page.id, "title")}>{page.title}</h1>
    {page.hero && (
      <img
        src={page.hero.src}
        srcset={page.hero.srcset}
        sizes="(min-width: 720px) 720px, 100vw"
        width={page.hero.width}
        height={page.hero.height}
        alt={page.hero.alt ?? ""}
        style="max-width: 100%; height: auto"
      />
    )}
    <p style="white-space: pre-wrap" data-cms={edit("pages", page.id, "body")}>
      {page.body}
    </p>
  </body>
</html>
