---
import type { InferGetStaticPropsType } from "astro";
import { edit } from "integral-cms/preview";
import cms from "../../../integral.config";

// Built once per post. Edits show after the next build; images stay live, served by /api/cms/media.
export const prerender = true;

export async function getStaticPaths() {
  const posts = await cms.find("posts");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post.title}</title>
  </head>
  <body>
    <a href="/">← Home</a>
    <h1
      style={post.color ? `border-left: 4px solid ${post.color}; padding-left: 8px` : undefined}
      data-cms={edit("posts", post.id, "title")}
    >
      {post.title}
    </h1>
    {post.author && (
      <p style="color:blue" data-cms={edit("authors", post.author.id, "name")}>
        {post.author.name}
      </p>
    )}
    {post.publishedAt && <time datetime={post.publishedAt}>{post.publishedAt}</time>}
    {post.hero && (
      <img
        src={post.hero.src}
        srcset={post.hero.srcset}
        sizes="(min-width: 720px) 720px, 100vw"
        width={post.hero.width}
        height={post.hero.height}
        alt={post.hero.alt ?? ""}
        style="max-width: 100%; height: auto"
        data-cms={edit("posts", post.id, "hero")}
        data-cms-attr="src,srcset,alt"
      />
    )}
    <p style="white-space: pre-wrap" data-cms={edit("posts", post.id, "body")}>
      {post.body}
    </p>
  </body>
</html>
