---
export const prerender = false;

const { integral: cms } = Astro.locals;
const general = await cms.getGlobal("general");
const posts = await cms.find("posts");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{general.title ?? "My site"}</title>
  </head>
  <body>
    <h1>{general.title ?? "My site"}</h1>
    {general.tagline && <p>{general.tagline}</p>}
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.slug}`}>{post.title}</a>
          {post.featured && " ★"}
          <p>{post.author?.name}</p>
        </li>
      ))}
    </ul>
    <p>
      <a href="/admin">Admin</a>
    </p>
  </body>
</html>
