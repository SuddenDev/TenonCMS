{
  "frameworks": {
    "astro": {
      "label": "Astro",
      "envModule": "astro:env/server",
      "targets": ["node", "vercel", "cloudflare"]
    },
    "nuxt": { "label": "Nuxt", "runtimeConfig": true, "targets": ["node", "vercel"] },
    "tanstack": { "label": "TanStack Start", "targets": ["node", "vercel"] },
    "standalone": {
      "label": "Standalone",
      "hint": "headless: API and admin only",
      "targets": ["node", "vercel"]
    }
  },
  "templates": {
    "minimal": {
      "label": "Minimal",
      "hint": "one collection and two pages",
      "frameworks": ["astro", "nuxt", "tanstack", "standalone"]
    }
  },
  "targets": {
    "node": {
      "label": "Node",
      "hint": "a server you run",
      "databases": ["libsql", "postgres", "pglite", "sqlite"],
      "storages": ["local", "s3", "r2"],
      "images": [
        "ipx",
        "none",
        "cloudflare-url",
        "netlify",
        "imgix",
        "cloudinary",
        "imagekit",
        "bunny",
        "imgproxy",
        "thumbor"
      ],
      "emails": ["none", "smtp", "cloudflare"]
    },
    "vercel": {
      "label": "Vercel",
      "hint": "serverless functions",
      "databases": ["libsql", "postgres"],
      "storages": ["s3", "r2"],
      "images": [
        "none",
        "vercel",
        "ipx",
        "cloudflare-url",
        "imgix",
        "cloudinary",
        "imagekit",
        "bunny",
        "imgproxy",
        "thumbor"
      ],
      "emails": ["none", "smtp", "cloudflare"]
    },
    "cloudflare": {
      "label": "Cloudflare",
      "hint": "Workers",
      "envFile": ".dev.vars",
      "databases": ["durable-object"],
      "storages": ["r2"],
      "images": [
        "cloudflare",
        "cloudflare-url",
        "none",
        "imgix",
        "cloudinary",
        "imagekit",
        "bunny",
        "imgproxy",
        "thumbor"
      ],
      "emails": ["none", "cloudflare", "smtp"]
    }
  },
  "databases": {
    "libsql": { "label": "SQLite / Turso", "hint": "a local file, or Turso by URL" },
    "postgres": { "label": "Postgres", "hint": "e.g. Neon or your own server" },
    "pglite": { "label": "PGlite", "hint": "Postgres in a folder, no server" },
    "sqlite": { "label": "node:sqlite", "hint": "a file, without a native dependency" },
    "durable-object": { "label": "Durable Object", "hint": "SQLite inside Cloudflare" }
  },
  "storages": {
    "local": { "label": "Local disk", "hint": "./.uploads" },
    "s3": { "label": "S3-compatible bucket", "hint": "AWS, R2, Neon, MinIO…" },
    "r2": { "label": "R2", "hint": "a binding on Cloudflare, API keys elsewhere" }
  },
  "images": {
    "ipx": { "label": "IPX", "hint": "WebP variants rendered by sharp on your server, adds ipx" },
    "none": { "label": "None", "hint": "originals only" },
    "cloudflare": { "label": "Cloudflare Images", "hint": "rendered through the Images binding" },
    "cloudflare-url": {
      "label": "Cloudflare image transformations",
      "hint": "/cdn-cgi/image on your zone"
    },
    "vercel": { "label": "Vercel Image Optimization", "hint": "needs images in the Vercel config" },
    "netlify": { "label": "Netlify Image CDN", "hint": "only when deployed on Netlify" },
    "imgix": { "label": "imgix" },
    "cloudinary": { "label": "Cloudinary" },
    "imagekit": { "label": "ImageKit" },
    "bunny": { "label": "Bunny Optimizer" },
    "imgproxy": { "label": "imgproxy", "hint": "self-hosted" },
    "thumbor": { "label": "Thumbor", "hint": "self-hosted" }
  },
  "emails": {
    "none": { "label": "None", "hint": "add one later in tenon.config.ts" },
    "cloudflare": {
      "label": "Cloudflare Email Service",
      "hint": "a binding on Cloudflare, an API token elsewhere"
    },
    "smtp": { "label": "SMTP", "hint": "adds nodemailer" }
  }
}
