{
  "files": {
    "tenon.config.ts": {
      "imports": ["import { r2 } from \"tenoncms/media/r2\";"],
      "media": [
        "storage: r2({",
        "  accountId: $CLOUDFLARE_ACCOUNT_ID,",
        "  bucket: $R2_BUCKET,",
        "  prefix: $R2_PREFIX,",
        "  accessKeyId: $R2_ACCESS_KEY_ID,",
        "  secretAccessKey: $R2_SECRET_ACCESS_KEY,",
        "}),"
      ]
    }
  },
  "env": [
    { "name": "CLOUDFLARE_ACCOUNT_ID", "comment": "Your Cloudflare account ID.", "example": "" },
    {
      "name": "R2_ACCESS_KEY_ID",
      "comment": "The keys of an R2 API token. The bucket's CORS MUST allow PUT from the site and expose ETag.",
      "example": ""
    },
    { "name": "R2_SECRET_ACCESS_KEY", "example": "" },
    { "name": "R2_BUCKET", "example": "uploads" },
    {
      "name": "R2_PREFIX",
      "comment": "Optional folder inside the bucket, so several sites can share it.",
      "optional": true
    }
  ]
}
