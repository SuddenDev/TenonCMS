{
  "files": {
    "tenon.config.ts": {
      "imports": ["import { smtp } from \"tenoncms/email/smtp\";"],
      "setup": ["const smtpPort = Number($SMTP_PORT);"],
      "options": [
        "email: {",
        "  adapter: smtp({",
        "    host: $SMTP_HOST,",
        "    port: smtpPort,",
        "    secure: smtpPort === 465,",
        "    auth: { user: $SMTP_USER, pass: $SMTP_PASSWORD },",
        "  }),",
        "  from: $EMAIL_FROM,",
        "},"
      ]
    }
  },
  "env": [
    { "name": "SMTP_HOST", "example": "smtp.example.test" },
    {
      "name": "SMTP_PORT",
      "comment": "Port 465 connects with TLS. Any other port, such as 587, upgrades with STARTTLS.",
      "default": "465"
    },
    { "name": "SMTP_USER", "example": "" },
    { "name": "SMTP_PASSWORD", "example": "" },
    { "name": "EMAIL_FROM", "example": "My Site <hello@example.test>" }
  ]
}
