{
  "files": {
    "astro.config.ts": {
      "imports": ["import cloudflare from \"@astrojs/cloudflare\";"],
      "options": [
        "adapter: cloudflare(),",
        "// Tenon keeps its own sessions. With Astro's, the adapter binds a KV namespace that a deploy creates.",
        "session: false,"
      ]
