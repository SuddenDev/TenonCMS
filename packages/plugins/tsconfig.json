{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "tenoncms": ["../core/src/index.ts"],
      "tenoncms/richtext": ["../core/src/richtext/index.ts"],
      "tenoncms/admin": ["../core/src/admin/config.ts"],
      "tenoncms/client": ["../core/src/client/index.ts"],
      "tenoncms/libsql": ["../core/src/integrations/libsql/index.ts"],
      "tenoncms/presets": ["../core/src/presets/index.ts"],
      "tenoncms/media/default": ["../core/src/media/default.ts"],
      "tenoncms/admin/bar": ["../core/src/admin/bar.d.ts"],
      "tenoncms/admin/vue": ["../core/src/admin/vue/vue.ts"],
      "tenoncms/admin/react": ["../core/src/admin/react/react.ts"]
    }
  },
  "include": ["src", "*.config.ts"]
}
