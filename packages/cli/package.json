{
  "name": "@tenoncms/cli",
  "version": "0.25.0",
  "description": "The tenon CLI: back up, restore and upgrade a tenoncms site",
  "license": "MIT",
  "author": {
    "name": "Dominik Tampe",
    "email": "hello@dtampe.com",
    "url": "https://dtampe.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuddenDev/TenonCMS.git",
    "directory": "packages/cli"
  },
  "bin": {
    "tenon": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "test -f dist/index.mjs || (echo \"Run pnpm build:packages in the repository root first.\" && exit 1)"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tenoncms": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "tenoncms": "workspace:^",
    "vite": ">=8"
  },
  "engines": {
    "node": ">=24"
  }
}
