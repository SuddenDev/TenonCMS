{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "integral-cms/richtext": ["../core/src/richtext/index.ts"],
      "@/*": ["./src/*"],
      "integral-cms": ["../core/src/index.ts"]
    }
  },
  "include": ["src"]
}
