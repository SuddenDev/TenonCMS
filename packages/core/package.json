    },
    "./media/cloudflare": {
      "types": "./dist/media/images/cloudflare.d.mts",
      "default": "./dist/media/images/cloudflare.mjs"
    },
    "./media/default": {
      "types": "./dist/media/default.d.mts",
      "workerd": "./dist/media/workerd.mjs",
      "default": "./dist/media/default.mjs"
    }
