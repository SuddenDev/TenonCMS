      "default": "./dist/client/index.mjs"
    },
    "./register": {
      "types": "./dist/client/register.d.ts"
    },
    "./astro": {
      "types": "./dist/integrations/astro/index.d.mts",
      "default": "./dist/integrations/astro/index.mjs"
