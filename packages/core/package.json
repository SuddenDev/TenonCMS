    "@nuxt/schema": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "aws4fetch": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
