    "@nuxt/schema": "^4.5.2",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro": "^7.3.4",
    "aws4fetch": "^1.0.20",
    "h3": "^1.15.11",
    "happy-dom": "^20.14.5",
    "idiomorph": "^0.8.0",
    "nuxt": "^4.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
