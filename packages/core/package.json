      "types": "./dist/integrations/nuxt/index.d.mts",
      "default": "./dist/integrations/nuxt/index.mjs"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./admin/vue": {
      "types": "./dist/admin/vue.d.mts",
      "default": "./dist/admin/vue.mjs"
    },
    "./admin/react": {
      "types": "./dist/admin/react.d.mts",
      "default": "./dist/admin/react.mjs"
    },
    "./preview": {
      "types": "./dist/preview/index.d.mts",
      "default": "./dist/preview/index.mjs"
    },
    "./preview/vue": {
      "types": "./dist/preview/vue.d.mts",
      "default": "./dist/preview/vue.mjs"
    },
    "./preview/react": {
      "types": "./dist/preview/react.d.mts",
      "default": "./dist/preview/react.mjs"
    },
