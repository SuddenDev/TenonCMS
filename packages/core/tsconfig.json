{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "integral-cms": ["./src/index.ts"],
      "integral-cms/admin": ["./src/admin/config.ts"],
      "integral-cms/media/default": ["./src/media/default.ts"],
      "integral-cms/admin/bar": ["./src/admin/bar.d.ts"]
    }
  },
  "include": ["src", "env.d.ts"]
}
