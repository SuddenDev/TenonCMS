{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "tenoncms": ["./src/index.ts"],
      "tenoncms/richtext": ["./src/richtext/index.ts"],
      "tenoncms/cloudflare": ["./src/integrations/cloudflare/index.ts"],
      "tenoncms/admin": ["./src/admin/config.ts"],
      "tenoncms/media/default": ["./src/media/default.ts"],
      "tenoncms/admin/bar": ["./src/admin/bar.d.ts"]
    }
  },
  "include": ["src", "env.d.ts"],
  // They need the Workers types, which clash with the DOM and Node types of the rest. Vitest runs them unchecked.
  "exclude": ["src/**/*.workerd.test.ts", "src/tests/workerd"]
}
