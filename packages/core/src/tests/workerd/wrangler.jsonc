// The Worker of the workerd tests (`*.workerd.test.ts`).
{
  "name": "tenoncms-workerd-tests",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "CMS", "class_name": "CmsObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CmsObject"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tenoncms-workerd-tests" }],
}
