---
export const prerender = false

const base = Astro.routePattern.replace('/[...path]', '')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Integral CMS - Admin</title>
  </head>
  <body>
    <div id="admin" data-base={base}></div>
    <script>
      import options from '#integral/admin'
      import { mountAdmin } from 'integral-cms/admin'

      const el = document.getElementById('admin')!
      mountAdmin(el, options, el.dataset.base)
    </script>
  </body>
</html>
